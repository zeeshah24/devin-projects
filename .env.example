# Copy to .env and fill in what you need. All keys are optional.

# LLM synthesis (any OpenAI-compatible API). Without a key you get an evidence digest.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Google Gemini free tier (AIza... or AQ. keys; this host uses Google's native API):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Live U.S. macro data: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Google News RSS keyword search for country questions (1 to enable)
# ENABLE_NEWS_SEARCH=1
